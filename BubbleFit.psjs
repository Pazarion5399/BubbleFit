// BubbleFit.psjs  -  fits TypeR text into speech bubbles (English + Arabic)
// v1.3 (14 Nov 2026) - the SS / سس rule: the side margin of every line is the width of "SS" (English) or "سس" (Arabic) in the text's own
//   font and size, measured in Photoshop; the text grows until those imagined letters touch the bubble edge (never closer).
//   Works with any active tool (Magic Wand, brushes...): switches to the Move tool while it runs, then gives your tool back.
// v1.2 (13 Nov 2026) - based on v1.0: keeps each text in the lobe it already sits in (no RTL swap), centres on the real ink
//   (hand-shaped / tatweel lines, edited box size don't matter), ignores tashkeel above the first / below the last line.
// v1.0 (Nov 2026)  -  run from File > Scripts (or assign a shortcut). One Ctrl+Z undoes it.
// ===================== BubbleFit core (pure JavaScript, no Photoshop calls) =====================
// Works on raw RGB pixels. Used by BubbleFit.psjs inside Photoshop and by the offline test harness.
'use strict';
var BF = {};

// ---------- small helpers ----------
BF.lum = function (r, g, b) { return 0.299 * r + 0.587 * g + 0.114 * b; };
BF.isRTL = function (s) { return /[֐-׿؀-ۿݐ-ݿࢠ-ࣿﭐ-﷿ﹰ-﻿]/.test(s || ''); };

// ---------- seed: most common colour near the text centre (text is hidden) ----------
BF.pickSeed = function (img, cx, cy, rad) {
  var w = img.w, h = img.h, c = img.comp, d = img.data;
  var x0 = Math.max(0, Math.round(cx - rad)), x1 = Math.min(w - 1, Math.round(cx + rad));
  var y0 = Math.max(0, Math.round(cy - rad)), y1 = Math.min(h - 1, Math.round(cy + rad));
  var hist = new Map(), bestKey = -1, bestCnt = 0;
  var step = Math.max(1, Math.round(rad / 12));
  for (var y = y0; y <= y1; y += step) for (var x = x0; x <= x1; x += step) {
    var o = (y * w + x) * c, key = ((d[o] >> 4) << 8) | ((d[o + 1] >> 4) << 4) | (d[o + 2] >> 4);
    var n = (hist.get(key) || 0) + 1; hist.set(key, n);
    if (n > bestCnt) { bestCnt = n; bestKey = key; }
  }
  var best = null, bd = 1e18;
  for (y = y0; y <= y1; y += step) for (x = x0; x <= x1; x += step) {
    o = (y * w + x) * c; key = ((d[o] >> 4) << 8) | ((d[o + 1] >> 4) << 4) | (d[o + 2] >> 4);
    if (key !== bestKey) continue;
    var dd = (x - cx) * (x - cx) + (y - cy) * (y - cy);
    if (dd < bd) { bd = dd; best = { x: x, y: y }; }
  }
  return best || { x: Math.round(cx), y: Math.round(cy) };
};

// ---------- region growing (flood fill that can follow gentle gradients) ----------
// P = {tg: tolerance to seed colour, tl: step tolerance to neighbour, tf: max distance to seed when following gradient, maxCount}
BF.grow = function (img, sx, sy, P, ws, win) {
  var w = img.w, h = img.h, c = img.comp, d = img.data, N = w * h;
  var wx0 = win ? win[0] : 0, wy0 = win ? win[1] : 0, wx1 = win ? win[2] : w - 1, wy1 = win ? win[3] : h - 1;
  if (!ws.marks || ws.marks.length !== N) { ws.marks = new Uint32Array(N); ws.stamp = 0; ws.queue = new Int32Array(1 << 18); }
  var stamp = ++ws.stamp, marks = ws.marks, q = ws.queue;
  var si = sy * w + sx, so = si * c, sr = d[so], sg = d[so + 1], sb = d[so + 2];
  var head = 0, tail = 0; q[tail++] = si; marks[si] = stamp;
  var minx = sx, maxx = sx, miny = sy, maxy = sy, count = 0, leak = false;
  var tg = P.tg, tl = P.tl, tf = P.tf, maxCount = P.maxCount;
  while (head < tail) {
    var p = q[head++]; count++;
    if (count > maxCount) { leak = true; break; }
    var px = p % w, py = (p - px) / w;
    if (px < minx) minx = px; if (px > maxx) maxx = px; if (py < miny) miny = py; if (py > maxy) maxy = py;
    var po = p * c, pr = d[po], pg = d[po + 1], pb = d[po + 2];
    for (var k = 0; k < 4; k++) {
      var qq;
      if (k === 0) { if (px <= wx0) continue; qq = p - 1; }
      else if (k === 1) { if (px >= wx1) continue; qq = p + 1; }
      else if (k === 2) { if (py <= wy0) continue; qq = p - w; }
      else { if (py >= wy1) continue; qq = p + w; }
      if (marks[qq] === stamp) continue;
      var qo = qq * c, qr = d[qo], qg = d[qo + 1], qb = d[qo + 2];
      var a = qr - sr; if (a < 0) a = -a; var b2 = qg - sg; if (b2 < 0) b2 = -b2; var c2 = qb - sb; if (c2 < 0) c2 = -c2;
      var ds = a > b2 ? (a > c2 ? a : c2) : (b2 > c2 ? b2 : c2);
      var ok = ds <= tg;
      if (!ok && tl > 0 && ds <= tf) {
        a = qr - pr; if (a < 0) a = -a; b2 = qg - pg; if (b2 < 0) b2 = -b2; c2 = qb - pb; if (c2 < 0) c2 = -c2;
        var dl = a > b2 ? (a > c2 ? a : c2) : (b2 > c2 ? b2 : c2);
        ok = dl <= tl;
      }
      if (ok) {
        marks[qq] = stamp;
        if (tail >= q.length) { var nq = new Int32Array(q.length * 2); nq.set(q); q = nq; ws.queue = q; }
        q[tail++] = qq;
      }
    }
  }
  return { stamp: stamp, leak: leak, count: count, x0: minx, y0: miny, x1: maxx, y1: maxy, seed: [sr, sg, sb], sx: sx, sy: sy };
};

// ---------- exact Euclidean distance transform (Felzenszwalb) : distance of each 1-pixel to nearest 0-pixel ----------
function dt1(f, n, d, v, z) {
  var k = 0; v[0] = 0; z[0] = -1e30; z[1] = 1e30;
  for (var q = 1; q < n; q++) {
    var s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]);
    while (s <= z[k]) { k--; s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]); }
    k++; v[k] = q; z[k] = s; z[k + 1] = 1e30;
  }
  k = 0;
  for (q = 0; q < n; q++) { while (z[k + 1] < q) k++; var dq = q - v[k]; d[q] = dq * dq + f[v[k]]; }
}
BF.edt = function (mask, w, h) {
  var INF = 1e20, n = Math.max(w, h);
  var f = new Float64Array(n), d = new Float64Array(n), z = new Float64Array(n + 1), v = new Int32Array(n);
  var tmp = new Float64Array(w * h), out = new Float32Array(w * h), x, y;
  for (x = 0; x < w; x++) {
    for (y = 0; y < h; y++) f[y] = mask[y * w + x] ? INF : 0;
    dt1(f, h, d, v, z);
    for (y = 0; y < h; y++) tmp[y * w + x] = d[y];
  }
  for (y = 0; y < h; y++) {
    var row = y * w;
    for (x = 0; x < w; x++) f[x] = tmp[row + x];
    dt1(f, w, d, v, z);
    for (x = 0; x < w; x++) out[row + x] = Math.sqrt(d[x]);
  }
  return out;
};

// ---------- working mask of a grown region (downsampled), with holes filled ----------
BF.workingMask = function (img, reg, ws, maxDim) {
  var bw = reg.x1 - reg.x0 + 1, bh = reg.y1 - reg.y0 + 1;
  var f = Math.max(1, Math.ceil(Math.max(bw, bh) / maxDim));
  var ww = Math.ceil(bw / f) + 2, wh = Math.ceil(bh / f) + 2;
  var ox = reg.x0 - f, oy = reg.y0 - f, off = f >> 1, W = img.w, H = img.h;
  var m = new Uint8Array(ww * wh), frac = new Uint8Array(ww * wh), marks = ws.marks, st = reg.stamp;
  for (var wy = 1; wy < wh - 1; wy++) {
    for (var wx = 1; wx < ww - 1; wx++) {
      // a cell is inside only when ALL its pixels are inside (thin outlines and lines stay walls)
      var inn = 0, tot = 0;
      for (var yy = 0; yy < f; yy++) { var ry = oy + wy * f + yy; if (ry < 0 || ry >= H) continue;
        var rowb = ry * W;
        for (var xx = 0; xx < f; xx++) { var rx = ox + wx * f + xx; if (rx < 0 || rx >= W) continue; tot++; if (marks[rowb + rx] === st) inn++; } }
      if (tot && inn === tot) m[wy * ww + wx] = 1;
      if (tot) frac[wy * ww + wx] = Math.round(255 * inn / tot);
    }
  }
  return { m: m, frac: frac, w: ww, h: wh, f: f, ox: ox, oy: oy, off: off };
};

// soft border (spikes, fuzz, glow): how far the bubble colour keeps going past the solid interior, in working pixels.
// A hard outline gives ~0.5; a spiky/fuzzy edge gives several pixels, and the text may use that space.
BF.softEdge = function (wm) {
  var w = wm.w, h = wm.h, n = w * h, inv = new Uint8Array(n), i, K = 12;
  for (i = 0; i < n; i++) inv[i] = wm.m[i] ? 0 : 1;
  var dOut = BF.edt(inv, w, h), hist = [], cnt = new Int32Array(K + 1);
  for (var k = 0; k <= K; k++) hist.push(new Int32Array(17));
  for (i = 0; i < n; i++) { var d = dOut[i]; if (d <= 0 || d > K) continue; var kk = Math.ceil(d); hist[kk][wm.frac[i] >> 4]++; cnt[kk]++; }
  var soft = 0;
  for (k = 1; k <= K; k++) {
    if (!cnt[k]) break;
    var half = cnt[k] / 2, acc2 = 0, b = 0; for (; b < 17; b++) { acc2 += hist[k][b]; if (acc2 >= half) break; }
    var med = (b * 16 + 8) / 255; if (med < 0.1) break; soft += Math.min(1, med);
  }
  return soft;
};
// fill holes inside the region, but only compact ones (dirt, leftover letters, lines inside the bubble).
// Long thin rings (a bubble outline between the bubble and leaked page area) stay walls.
BF.fillHoles = function (m, ww, wh) {
  var n = ww * wh, lab = new Int32Array(n), q = new Int32Array(n), i, h0, t;
  // 1) mark background connected to the border
  h0 = 0; t = 0; q[t++] = 0; lab[0] = -1;
  while (h0 < t) {
    var p = q[h0++], px = p % ww, py = (p - px) / ww;
    if (px > 0 && !lab[p - 1] && !m[p - 1]) { lab[p - 1] = -1; q[t++] = p - 1; }
    if (px < ww - 1 && !lab[p + 1] && !m[p + 1]) { lab[p + 1] = -1; q[t++] = p + 1; }
    if (py > 0 && !lab[p - ww] && !m[p - ww]) { lab[p - ww] = -1; q[t++] = p - ww; }
    if (py < wh - 1 && !lab[p + ww] && !m[p + ww]) { lab[p + ww] = -1; q[t++] = p + ww; }
  }
  // 2) each remaining 0-component is a hole: fill if compact or small
  var next = 1, maxSide = Math.max(ww, wh);
  for (i = 0; i < n; i++) {
    if (m[i] || lab[i]) continue;
    var id = next++, area = 0, x0 = ww, y0 = wh, x1 = 0, y1 = 0; h0 = 0; t = 0; q[t++] = i; lab[i] = id;
    while (h0 < t) {
      p = q[h0++]; px = p % ww; py = (p - px) / ww; area++;
      if (px < x0) x0 = px; if (px > x1) x1 = px; if (py < y0) y0 = py; if (py > y1) y1 = py;
      if (px > 0 && !lab[p - 1] && !m[p - 1]) { lab[p - 1] = id; q[t++] = p - 1; }
      if (px < ww - 1 && !lab[p + 1] && !m[p + 1]) { lab[p + 1] = id; q[t++] = p + 1; }
      if (py > 0 && !lab[p - ww] && !m[p - ww]) { lab[p - ww] = id; q[t++] = p - ww; }
      if (py < wh - 1 && !lab[p + ww] && !m[p + ww]) { lab[p + ww] = id; q[t++] = p + ww; }
    }
    var bw = x1 - x0 + 1, bh = y1 - y0 + 1, fillIt = (area >= 0.2 * bw * bh) || Math.max(bw, bh) <= 0.15 * maxSide;
    if (fillIt) for (var k = 0; k < t; k++) m[q[k]] = 1;
  }
  return m;
};
// keep only the part of the mask reachable from the seed through areas thicker than g (cuts leaks through gaps / thin tails)
BF.cutLeaks = function (m, w, h, sx, sy, g) {
  var D0 = BF.edt(m, w, h), n = w * h;
  // seed cell: nearest cell with enough thickness
  var seed = -1, bd = 1e18, R = Math.max(3, Math.ceil(g * 4));
  for (var y = Math.max(1, sy - R); y < Math.min(h - 1, sy + R); y++) for (var x = Math.max(1, sx - R); x < Math.min(w - 1, sx + R); x++) {
    var i = y * w + x; if (D0[i] < g) continue; var d = (x - sx) * (x - sx) + (y - sy) * (y - sy); if (d < bd) { bd = d; seed = i; }
  }
  if (seed < 0) return m;
  var core = new Uint8Array(n), q = new Int32Array(n), h0 = 0, t = 0; core[seed] = 1; q[t++] = seed;
  while (h0 < t) {
    var p = q[h0++], px = p % w;
    var nb = [px > 0 ? p - 1 : -1, px < w - 1 ? p + 1 : -1, p - w, p + w];
    for (var k = 0; k < 4; k++) { var qq = nb[k]; if (qq < 0 || qq >= n || core[qq] || D0[qq] < g) continue; core[qq] = 1; q[t++] = qq; }
  }
  // grow the core back by g (only inside the original mask)
  var inv = new Uint8Array(n); for (var j = 0; j < n; j++) inv[j] = core[j] ? 0 : 1;
  var Dc = BF.edt(inv, w, h), out = new Uint8Array(n);
  for (j = 0; j < n; j++) if (m[j] && Dc[j] <= g + 0.75) out[j] = 1;
  return out;
};

// ---------- split a mask into lobes (joined bubbles) with persistence on the distance map ----------
BF.lobes = function (D, w, h, rel, minFrac) {
  var n = w * h, maxD = 0, i;
  for (i = 0; i < n; i++) if (D[i] > maxD) maxD = D[i];
  var S = 4, nb = Math.floor(maxD * S) + 1, cnt = new Int32Array(nb + 1);
  for (i = 0; i < n; i++) if (D[i] > 0) cnt[Math.floor(D[i] * S)]++;
  var start = new Int32Array(nb + 1), acc = 0;
  for (var b = nb; b >= 0; b--) { start[b] = acc; acc += cnt[b]; }
  var order = new Int32Array(acc), fill = start.slice();
  for (i = 0; i < n; i++) if (D[i] > 0) order[fill[Math.floor(D[i] * S)]++] = i;
  var parent = new Int32Array(n).fill(-1), peak = new Float32Array(n);
  function find(a) { var r = a; while (parent[r] !== r) r = parent[r]; while (parent[a] !== r) { var nx = parent[a]; parent[a] = r; a = nx; } return r; }
  var nbr = [-w - 1, -w, -w + 1, -1, 1, w - 1, w, w + 1], roots = new Int32Array(8);
  for (var k = 0; k < acc; k++) {
    var p = order[k], nr = 0;
    for (var j = 0; j < 8; j++) {
      var qq = p + nbr[j]; if (qq < 0 || qq >= n || parent[qq] === -1) continue;
      var r = find(qq), dup = false;
      for (var t = 0; t < nr; t++) if (roots[t] === r) { dup = true; break; }
      if (!dup) roots[nr++] = r;
    }
    if (nr === 0) { parent[p] = p; peak[p] = D[p]; continue; }
    var main = roots[0];
    for (t = 1; t < nr; t++) if (peak[roots[t]] > peak[main]) main = roots[t];
    parent[p] = main;
    for (t = 0; t < nr; t++) {
      r = roots[t]; if (r === main) continue;
      var thr = Math.max(1.0, rel * peak[r]);
      if (peak[r] - D[p] < thr || (minFrac > 0 && peak[r] < minFrac * maxD)) parent[r] = main;
    }
  }
  // persistent lobes = final union-find roots.  Each pixel then goes to the lobe it climbs to (steepest ascent),
  // so the cut between two lobes runs along the neck and never around the rim of the smaller lobe.
  var label = new Int32Array(n).fill(-1), map = new Map(), lobes = [];
  function lobeOf(rt) {
    var id = map.get(rt);
    if (id === undefined) { id = lobes.length; map.set(rt, id); lobes.push({ id: id, peak: peak[rt], px: rt % w, py: Math.floor(rt / w), area: 0 }); }
    return id;
  }
  for (k = 0; k < acc; k++) {
    var pp = order[k], bq = -1, bd = -1;
    for (j = 0; j < 8; j++) { var q2 = pp + nbr[j]; if (q2 < 0 || q2 >= n || label[q2] < 0) continue; if (D[q2] > bd) { bd = D[q2]; bq = q2; } }
    label[pp] = (bq >= 0 && D[bq] > D[pp] - 0.26) ? label[bq] : lobeOf(find(pp));
    lobes[label[pp]].area++;
  }
  return { label: label, lobes: lobes, maxD: maxD };
};

// least-squares conic  A u^2 + B uv + C v^2 + D u + E v = 1  through outline points -> ellipse (or null)
BF.fitEllipse = function (P) {
  var n = P.length / 2, i; if (n < 12) return null;
  var mx = 0, my = 0; for (i = 0; i < n; i++) { mx += P[2 * i]; my += P[2 * i + 1]; } mx /= n; my /= n;
  var sc = 0; for (i = 0; i < n; i++) sc += Math.sqrt((P[2 * i] - mx) * (P[2 * i] - mx) + (P[2 * i + 1] - my) * (P[2 * i + 1] - my)); sc = sc / n || 1;
  var M = [], b = [0, 0, 0, 0, 0], a, c;
  for (a = 0; a < 5; a++) M.push([0, 0, 0, 0, 0]);
  for (i = 0; i < n; i++) {
    var u = (P[2 * i] - mx) / sc, v = (P[2 * i + 1] - my) / sc, r = [u * u, u * v, v * v, u, v];
    for (a = 0; a < 5; a++) { b[a] += r[a]; for (c = 0; c < 5; c++) M[a][c] += r[a] * r[c]; }
  }
  for (var col = 0; col < 5; col++) {
    var piv = col, rr; for (rr = col + 1; rr < 5; rr++) if (Math.abs(M[rr][col]) > Math.abs(M[piv][col])) piv = rr;
    if (Math.abs(M[piv][col]) < 1e-12) return null;
    var t = M[col]; M[col] = M[piv]; M[piv] = t; var tb = b[col]; b[col] = b[piv]; b[piv] = tb;
    for (rr = col + 1; rr < 5; rr++) { var fc = M[rr][col] / M[col][col]; for (c = col; c < 5; c++) M[rr][c] -= fc * M[col][c]; b[rr] -= fc * b[col]; }
  }
  var q = [0, 0, 0, 0, 0];
  for (var ri = 4; ri >= 0; ri--) { var sm = b[ri]; for (c = ri + 1; c < 5; c++) sm -= M[ri][c] * q[c]; q[ri] = sm / M[ri][ri]; }
  var A = q[0], B = q[1], C = q[2], Dd = q[3], E = q[4];
  if (!(A > 0 && C > 0 && B * B - 4 * A * C < 0)) return null;
  var det = 4 * A * C - B * B, u0 = (B * E - 2 * C * Dd) / det, v0 = (B * Dd - 2 * A * E) / det;
  var K = 1 - (A * u0 * u0 + B * u0 * v0 + C * v0 * v0 + Dd * u0 + E * v0);
  if (!(K > 0)) return null;
  var e = { A: A / K, B: B / K, C: C / K, u0: u0, v0: v0, mx: mx, my: my, sc: sc, cx: mx + u0 * sc, cy: my + v0 * sc };
  e.val = function (x, y) { var uu = (x - mx) / sc - u0, vv = (y - my) / sc - v0; return e.A * uu * uu + e.B * uu * vv + e.C * vv * vv; };
  return e;
};

// a lobe of a joined bubble seen as its OWN complete bubble: fit the full oval to its visible outline
// (tail and thin parts removed first), so the part hidden behind the other bubble is restored
BF.lobeEllipse = function (label, w, h, ids, Dfull) {
  var n = w * h, i, x, y, peak = 0, inL = new Uint8Array(n);
  for (i = 0; i < n; i++) if (ids.indexOf(label[i]) >= 0) { inL[i] = 1; if (Dfull[i] > peak) peak = Dfull[i]; }
  var r = 0.5 * peak, cS = new Uint8Array(n);
  for (i = 0; i < n; i++) cS[i] = (inL[i] && Dfull[i] >= r) ? 0 : 1;
  var dS = BF.edt(cS, w, h), P = [];
  for (y = 1; y < h - 1; y++) for (x = 1; x < w - 1; x++) {
    i = y * w + x;
    if (!inL[i] || dS[i] > r + 0.5) continue;
    if (Dfull[i - 1] > 0 && Dfull[i + 1] > 0 && Dfull[i - w] > 0 && Dfull[i + w] > 0) continue;
    P.push(x, y);
  }
  var e = BF.fitEllipse(P);
  if (!e) return null;
  // the oval must follow the outline it came from (not a wild fit)
  var bad = 0; for (i = 0; i < P.length; i += 2) { var vv = e.val(P[i], P[i + 1]); if (vv < 0.8 || vv > 1.25) bad++; }
  if (bad > 0.25 * P.length / 2) return null;
  return e;
};

// mask of one lobe (or of several ids) -> its own distance map and "core" centre (middle of the widest part, tails ignored)
BF.lobeField = function (label, w, h, ids, Dfull, multi) {
  var n = w * h, m = new Uint8Array(n), i;
  for (i = 0; i < n; i++) if (ids.indexOf(label[i]) >= 0) m[i] = 1;
  var Dl = BF.edt(m, w, h), D = Dl, maxD = 0, sx = 0, sy = 0, sw = 0, thr, x, y, wt;
  if (Dfull && multi && BF.CFG.lobeOval !== false) {
    var ell = BF.lobeEllipse(label, w, h, ids, Dfull);
    if (ell) {
      // text area = the lobe's full oval (restored through the overlap), never outside the real bubble
      var mE = new Uint8Array(n), cntE = 0, cntL = 0, cntLin = 0;
      for (i = 0; i < n; i++) {
        if (m[i]) cntL++;
        if (Dfull[i] > 0) { x = i % w; y = (i - x) / w; if (ell.val(x, y) <= 1) { mE[i] = 1; cntE++; if (m[i]) cntLin++; } }
      }
      var ci = Math.round(ell.cy) * w + Math.round(ell.cx);
      if (cntE >= 0.75 * cntL && cntE <= 2.4 * cntL && cntLin >= 0.7 * cntL && ci >= 0 && ci < n && mE[ci]) {
        var DE = BF.edt(mE, w, h), mxE = 0; for (i = 0; i < n; i++) if (DE[i] > mxE) mxE = DE[i];
        return { D: DE, maxD: mxE, cx: ell.cx, cy: ell.cy, w: w, h: h, lobeIds: ids.slice(), oval: true };
      }
    }
  }
  if (Dfull && multi) {
    // centre = middle of the biggest circle that fits in this lobe of the WHOLE bubble (the cut line does not pull it)
    var maxF = 0; for (i = 0; i < n; i++) if (m[i] && Dfull[i] > maxF) maxF = Dfull[i];
    thr = 0.92 * maxF;
    for (i = 0; i < n; i++) if (m[i] && Dfull[i] >= thr) { x = i % w; y = (i - x) / w; wt = Dfull[i] - thr + 0.5; sx += x * wt; sy += y * wt; sw += wt; }
    // containment: the real bubble edge always counts; the cut line between lobes may be crossed a little
    var allow = (BF.CFG.lobeAllow !== undefined ? BF.CFG.lobeAllow : 0.25) * maxF, inv = new Uint8Array(n); for (i = 0; i < n; i++) inv[i] = m[i] ? 0 : 1;
    var dOut = BF.edt(inv, w, h); D = new Float32Array(n);
    for (i = 0; i < n; i++) D[i] = m[i] ? Math.min(Dfull[i], Dl[i] + allow) : Math.max(0, Math.min(Dfull[i], allow - dOut[i]));
    for (i = 0; i < n; i++) if (D[i] > maxD) maxD = D[i];
    return { D: D, maxD: maxD, cx: sx / sw, cy: sy / sw, w: w, h: h, lobeIds: ids.slice() };
  }
  for (i = 0; i < n; i++) if (D[i] > maxD) maxD = D[i];
  // optical centre: the bubble's body without tail / thin parts (opening with r = maxD/2),
  // half-way between the middle of its bounding box and its centre of mass (boxes stay centred, round bubbles too)
  var r = 0.5 * maxD, cS = new Uint8Array(n);
  for (i = 0; i < n; i++) cS[i] = (m[i] && D[i] >= r) ? 0 : 1;
  var dS = BF.edt(cS, w, h), x0 = w, x1 = -1, y0 = h, y1 = -1, cnt = 0;
  for (i = 0; i < n; i++) if (m[i] && dS[i] <= r + 0.5) {
    x = i % w; y = (i - x) / w; sx += x; sy += y; cnt++;
    if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y;
  }
  if (!cnt) { thr = maxD * 0.9; for (i = 0; i < n; i++) if (D[i] >= thr) { x = i % w; y = (i - x) / w; sx += x; sy += y; cnt++; x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); } }
  var cxx = 0.5 * (x0 + x1) / 2 + 0.5 * sx / cnt, cyy = 0.5 * (y0 + y1) / 2 + 0.5 * sy / cnt;
  return { D: D, maxD: maxD, cx: cxx, cy: cyy, w: w, h: h, lobeIds: ids.slice() };
};

// split one lobe into k parts along its long axis (several texts in one plain bubble)
BF.splitLobe = function (label, w, h, id, k, newIdStart) {
  var px = [], sx = 0, sy = 0, n = 0, i;
  for (i = 0; i < label.length; i++) if (label[i] === id) { var x = i % w, y = (i - x) / w; px.push(i); sx += x; sy += y; n++; }
  var mx = sx / n, my = sy / n, cxx = 0, cyy = 0, cxy = 0;
  for (i = 0; i < n; i++) { x = px[i] % w; y = (px[i] - x) / w; cxx += (x - mx) * (x - mx); cyy += (y - my) * (y - my); cxy += (x - mx) * (y - my); }
  var ang = 0.5 * Math.atan2(2 * cxy, cxx - cyy), ux = Math.cos(ang), uy = Math.sin(ang);
  var proj = px.map(function (p) { var x = p % w, y = (p - x) / w; return (x - mx) * ux + (y - my) * uy; });
  var sorted = proj.slice().sort(function (a, b) { return a - b; }), cuts = [];
  for (var c = 1; c < k; c++) cuts.push(sorted[Math.floor(c * n / k)]);
  var ids = []; for (c = 0; c < k; c++) ids.push(newIdStart + c);
  for (i = 0; i < n; i++) { var part = 0; while (part < k - 1 && proj[i] >= cuts[part]) part++; label[px[i]] = ids[part]; }
  return ids;
};

// ---------- text fitting ----------
// pts: sample points of the text ink relative to the ink-box centre, in working pixels at scale 1
// field: {D, w, h, maxD}; pad(s) = padA*s + padB (working pixels)
BF.makeFitter = function (field, pts, padA, padB, padMinA) {
  padMinA = padMinA || 0;
  var D = field.D, w = field.w, h = field.h, X = pts.x, Y = pts.y, n = pts.n;
  function margin(cx, cy, s, stop) {
    var pad = Math.max(padMinA * s + 0.5, padA * s + padB), m = 1e9;
    for (var i = 0; i < n; i++) {
      var x = (cx + s * X[i] + 0.5) | 0, y = (cy + s * Y[i] + 0.5) | 0;
      if (x < 0 || y < 0 || x >= w || y >= h) return -1e9;
      var v = D[y * w + x] - pad;
      if (v < m) { m = v; if (m < stop) return m; }
    }
    return m;
  }
  function best(s) {
    var pad = Math.max(padMinA * s + 0.5, padA * s + padB), g = Math.max(1, Math.round(field.maxD / 7)), b = { m: -1e9, x: 0, y: 0 };
    for (var y = 1; y < h - 1; y += g) for (var x = 1; x < w - 1; x += g) {
      if (D[y * w + x] < pad) continue;
      var m = margin(x, y, s, b.m);
      if (m > b.m) b = { m: m, x: x, y: y };
    }
    if (b.m <= -1e8) return b;
    var st = g;
    while (st >= 1) {
      var moved = false;
      for (var dy = -1; dy <= 1; dy++) for (var dx = -1; dx <= 1; dx++) {
        if (!dx && !dy) continue;
        var nx = b.x + dx * st, ny = b.y + dy * st, mm = margin(nx, ny, s, b.m);
        if (mm > b.m) { b = { m: mm, x: nx, y: ny }; moved = true; }
      }
      if (!moved) st = st >> 1;
    }
    return b;
  }
  function maxScale(sHi) {
    var lo = 0.02, hi = sHi, bb = best(hi);
    if (bb.m >= 0) return hi;
    for (var it = 0; it < 16; it++) { var mid = (lo + hi) / 2; if (best(mid).m >= 0) lo = mid; else hi = mid; }
    return lo;
  }
  // feasible position closest to the target centre G (optical centre of the lobe)
  function place(s, gx, gy, keep) {
    if (margin(gx, gy, s, -1e9) >= 0) return { x: gx, y: gy, m: margin(gx, gy, s, -1e9), exact: true };
    if (keep) {
      // start from the roomiest position and slide towards the centre while keeping part of that room
      var b0 = best(s);
      if (b0.m > -1e8) {
        var need = Math.max(0, keep * b0.m), ax0 = b0.x, ay0 = b0.y, tx = gx, ty = gy;
        for (var it0 = 0; it0 < 14; it0++) { var mx0 = (ax0 + tx) / 2, my0 = (ay0 + ty) / 2; if (margin(mx0, my0, s, need - 1e-6) >= need) { ax0 = mx0; ay0 = my0; } else { tx = mx0; ty = my0; } }
        return { x: ax0, y: ay0, m: margin(ax0, ay0, s, -1e9), exact: false };
      }
    }
    var R = Math.max(4, field.maxD * 1.6), st = Math.max(1, Math.round(field.maxD / 30)), bb = null, bd = 1e18;
    for (var y = Math.max(1, Math.round(gy - R)); y < Math.min(h - 1, gy + R); y += st)
      for (var x = Math.max(1, Math.round(gx - R)); x < Math.min(w - 1, gx + R); x += st) {
        var dd = (x - gx) * (x - gx) + (y - gy) * (y - gy); if (dd >= bd) continue;
        if (margin(x, y, s, 0) >= 0) { bd = dd; bb = { x: x, y: y }; }
      }
    if (!bb) { var b = best(s); return { x: b.x, y: b.y, m: b.m, exact: false }; }
    // pull towards G while still fitting
    var ax = bb.x, ay = bb.y;
    for (var it = 0; it < 12; it++) { var mx = (ax + gx) / 2, my = (ay + gy) / 2; if (margin(mx, my, s, 0) >= 0) { ax = mx; ay = my; } else { gx = mx; gy = my; } }
    return { x: ax, y: ay, m: margin(ax, ay, s, -1e9), exact: false };
  }
  return { margin: margin, best: best, maxScale: maxScale, place: place };
};

// sample points from an ink alpha bitmap (full resolution), converted to working pixels around the ink centre
BF.inkPoints = function (alpha, iw, ih, f, maxPts, refX, refY, sidePx, vertPx) {
  sidePx = sidePx || 0; vertPx = vertPx || 0;
  var minx = iw, maxx = -1, miny = ih, maxy = -1, x, y;
  var rowL = new Int32Array(ih).fill(-1), rowR = new Int32Array(ih).fill(-1), colT = new Int32Array(iw).fill(-1), colB = new Int32Array(iw).fill(-1);
  for (y = 0; y < ih; y++) for (x = 0; x < iw; x++) if (alpha[y * iw + x] > 60) {
    if (rowL[y] < 0) rowL[y] = x; rowR[y] = x; if (colT[x] < 0) colT[x] = y; colB[x] = y;
    if (x < minx) minx = x; if (x > maxx) maxx = x; if (y < miny) miny = y; if (y > maxy) maxy = y;
  }
  if (maxx < 0) return null;
  var cx = (refX !== undefined) ? refX : (minx + maxx + 1) / 2, cy = (refY !== undefined) ? refY : (miny + maxy + 1) / 2, P = [];
  var rows = maxy - miny + 1, cols = maxx - minx + 1, budget = maxPts || 260;
  var rs = Math.max(1, Math.round((rows * 2) / (budget * 0.55))), cs = Math.max(1, Math.round((cols * 2) / (budget * 0.45)));
  for (y = miny; y <= maxy; y += rs) if (rowL[y] >= 0) { P.push([rowL[y], y + 0.5]); P.push([rowR[y] + 1, y + 0.5]);
    // v1.3 SS rule: an imagined "SS" / "سس" box sits right and left of every line - its outer edge must stay inside the bubble
    if (sidePx > 0) { P.push([rowL[y] - sidePx, y + 0.5]); P.push([rowR[y] + 1 + sidePx, y + 0.5]); P.push([rowL[y] - sidePx / 2, y + 0.5]); P.push([rowR[y] + 1 + sidePx / 2, y + 0.5]); } }
  for (x = minx; x <= maxx; x += cs) if (colT[x] >= 0) { P.push([x + 0.5, colT[x]]); P.push([x + 0.5, colB[x] + 1]);
    if (vertPx > 0) { if (colT[x] - miny < vertPx) P.push([x + 0.5, miny - vertPx]); if (maxy - colB[x] < vertPx) P.push([x + 0.5, maxy + 1 + vertPx]); } }
  P.push([minx, miny]); P.push([maxx + 1, maxy + 1]);
  var n = P.length, X = new Float32Array(n), Y = new Float32Array(n);
  for (var i = 0; i < n; i++) { X[i] = (P[i][0] - cx) / f; Y[i] = (P[i][1] - cy) / f; }
  return { x: X, y: Y, n: n, inkBox: [minx, miny, maxx + 1, maxy + 1], cx: cx, cy: cy };
};

// reading order of lobes: rows top->bottom, inside a row left->right (or right->left for Arabic)
BF.readingOrder = function (fields, rtl) {
  var idx = fields.map(function (_, i) { return i; });
  idx.sort(function (a, b) {
    var A = fields[a], B = fields[b], tol = 0.55 * Math.min(A.maxD, B.maxD);
    if (Math.abs(A.cy - B.cy) > tol) return A.cy - B.cy;
    return rtl ? B.cx - A.cx : A.cx - B.cx;
  });
  return idx;
};



// ===================== planning: detect bubbles, split joined ones, assign texts, fit =====================
// texts: [{id, order, cx, cy, box:[l,t,r,b], ink:{alpha,w,h,ox,oy} or null, fontPx, rtl, target}]
BF.CFG = {
  padEm: 0.42, padPx: 3,          // breathing room between text and bubble edge
  fill: 0.88,                     // use 88% of the largest comfortable size (tuned on real typeset pages)
  padTightEm: 0.15, fillTight: 1.0, // when the text must shrink: shrink only as much as a tight fit needs
  lobeAllow: 0.15,                // joined bubbles: text may cross the cut line between lobes a little
  maxScale: 1.60, hardMin: 0.40, consistent: false,
  maxDim: 420,                    // working resolution per bubble (speed)
  lobeRel: 0.16, lobeMinFrac: 0,
  params: [ { tg: 60, tl: 8, tf: 150 }, { tg: 42, tl: 4, tf: 100 }, { tg: 26, tl: 0, tf: 0 } ]
};

BF.detect = function (img, T, cfg, ws, log) {
  var W = img.w, H = img.h, tw = Math.max(8, T.box[2] - T.box[0]), th = Math.max(8, T.box[3] - T.box[1]);
  function windowFor(k) {
    var rx = Math.max(1.5 * tw, 1.6 * th, 220) * Math.pow(1.8, k), ry = Math.max(2.2 * th, 0.9 * tw, 220) * Math.pow(1.8, k);
    return [Math.max(0, Math.round(T.cx - rx)), Math.max(0, Math.round(T.cy - ry)), Math.min(W - 1, Math.round(T.cx + rx)), Math.min(H - 1, Math.round(T.cy + ry))];
  }
  function touches(r, win) {
    return (r.x0 <= win[0] && win[0] > 0) || (r.y0 <= win[1] && win[1] > 0) || (r.x1 >= win[2] && win[2] < W - 1) || (r.y1 >= win[3] && win[3] < H - 1);
  }
  var seed = BF.pickSeed(img, T.cx, T.cy, Math.max(5, 0.22 * Math.min(tw, th)));
  var gFull = Math.max(3, Math.round(0.05 * Math.min(tw, th)));
  for (var pi = 0; pi < cfg.params.length; pi++) {
    var P = cfg.params[pi], r = null, win = null;
    for (var k = 0; k < 3; k++) {
      win = windowFor(k);
      r = BF.grow(img, seed.x, seed.y, { tg: P.tg, tl: P.tl, tf: P.tf, maxCount: 1e12 }, ws, win);
      if (!touches(r, win)) break;
    }
    if (r.count < 0.2 * tw * th) { if (log) log.push(T.id + ' p' + pi + ' region too small'); continue; }
    var wm = BF.workingMask(img, r, ws, cfg.maxDim);
    var sW = [Math.round((seed.x - wm.ox - wm.off) / wm.f), Math.round((seed.y - wm.oy - wm.off) / wm.f)];
    wm.m = BF.cutLeaks(wm.m, wm.w, wm.h, sW[0], sW[1], Math.max(1.5, gFull / wm.f));
    BF.fillHoles(wm.m, wm.w, wm.h);
    var D = BF.edt(wm.m, wm.w, wm.h);
    var L = BF.lobes(D, wm.w, wm.h, cfg.lobeRel, cfg.lobeMinFrac);
    var B = { wm: wm, D: D, L: L, seed: r.seed, param: pi, members: [], open: touches(r, win), win: win, imgW: W, imgH: H, soft: BF.softEdge(wm) };
    if (!L.lobes.length) continue;
    var lid = BF.lobeAt(B, T.cx, T.cy);
    if (!BF.lobeIsOpen(B, lid)) return B;
    if (log) log.push(T.id + ' p' + pi + ' open area');
  }
  if (log) log.push(T.id + ' no closed bubble found - left as is');
  return null;
};

// is a lobe a real closed bubble?  (not open page / art: its thick part must not run into an open window side)
BF.lobeIsOpen = function (B, id) {
  if (!B.open) return false;
  B.openCache = B.openCache || {}; if (B.openCache[id] !== undefined) return B.openCache[id];
  var wm = B.wm, w = wm.w, h = wm.h, lab = B.L.label, D = B.D, win = B.win, W = B.imgW, H = B.imgH, peak = B.L.lobes[id].peak, worst = 0;
  for (var wy = 1; wy < h - 1; wy++) for (var wx = 1; wx < w - 1; wx++) {
    var i = wy * w + wx; if (lab[i] !== id) continue;
    var fx = wm.ox + wx * wm.f + wm.off, fy = wm.oy + wy * wm.f + wm.off, e = 2 * wm.f;
    var nearOpen = (fx - win[0] <= e && win[0] > 0) || (fy - win[1] <= e && win[1] > 0) || (win[2] - fx <= e && win[2] < W - 1) || (win[3] - fy <= e && win[3] < H - 1);
    if (nearOpen && D[i] > worst) worst = D[i];
  }
  B.openCache[id] = worst >= 0.35 * peak;
  return B.openCache[id];
};

BF.inside = function (B, x, y) {
  var wm = B.wm, wx = Math.round((x - wm.ox - wm.off) / wm.f), wy = Math.round((y - wm.oy - wm.off) / wm.f);
  if (wx < 0 || wy < 0 || wx >= wm.w || wy >= wm.h) return false;
  return wm.m[wy * wm.w + wx] === 1;
};
BF.toW = function (B, x, y) { var wm = B.wm; return [(x - wm.ox - wm.off) / wm.f, (y - wm.oy - wm.off) / wm.f]; };
BF.toF = function (B, u, v) { var wm = B.wm; return [wm.ox + u * wm.f + wm.off, wm.oy + v * wm.f + wm.off]; };

BF.lobeAt = function (B, x, y) {
  var p = BF.toW(B, x, y), wx = Math.round(p[0]), wy = Math.round(p[1]), w = B.wm.w, lab = B.L.label;
  if (wx >= 0 && wy >= 0 && wx < w && wy < B.wm.h && lab[wy * w + wx] >= 0) return lab[wy * w + wx];
  var bi = 0, bd = 1e18;
  for (var i = 0; i < B.L.lobes.length; i++) { var lb = B.L.lobes[i], d = (lb.px - wx) * (lb.px - wx) + (lb.py - wy) * (lb.py - wy); if (d < bd) { bd = d; bi = i; } }
  return bi;
};

BF.assign = function (B, log) {
  var M = B.members.slice().sort(function (a, b) { return a.order - b.order; });
  var w = B.wm.w, h = B.wm.h, label = B.L.label, nl = B.L.lobes.length, k = M.length, out = [];
  var rtl = M.some(function (t) { return t.rtl; });
  if (k === 1) { out.push([M[0], BF.lobeField(label, w, h, [BF.lobeAt(B, M[0].cx, M[0].cy)], B.D, nl > 1)]); return out; }
  // which lobe does each text currently sit in?
  var at = M.map(function (t) { return BF.lobeAt(B, t.cx, t.cy); });
  var groups = {}; at.forEach(function (id, i) { (groups[id] = groups[id] || []).push(i); });
  var occupied = Object.keys(groups).map(Number);
  var lobeIds;
  if (nl === k) lobeIds = B.L.lobes.map(function (l) { return [l.id]; });
  else if (nl > k && occupied.length === k) lobeIds = occupied.map(function (id) { return [id]; });
  else {
    // fewer lobes than texts: split every lobe that holds several texts along its long axis
    lobeIds = []; var next = 1000;
    occupied.forEach(function (id) {
      var n = groups[id].length;
      if (n === 1) lobeIds.push([id]);
      else { var parts = BF.splitLobe(label, w, h, id, n, next); next += n; parts.forEach(function (p) { lobeIds.push([p]); }); }
    });
  }
  var fields = lobeIds.map(function (ids) { return BF.lobeField(label, w, h, ids, B.D, true); });
  if (occupied.length === k && lobeIds.every(function (ids) { return ids.length === 1 && ids[0] < 1000; })) {
    // v1.2: every text is already in its own lobe -> keep the typesetter's choice, never reorder
    for (var q = 0; q < k; q++) { var lid = at[q]; for (var fi = 0; fi < lobeIds.length; fi++) if (lobeIds[fi][0] === lid) out.push([M[q], fields[fi]]); }
    if (log) log.push('joined bubble: ' + k + ' texts kept in their own lobes');
    return out;
  }
  var ord = BF.readingOrder(fields, rtl);
  for (var i = 0; i < k && i < ord.length; i++) out.push([M[i], fields[ord[i]]]);
  if (log) log.push('joined bubble: ' + k + ' texts, ' + nl + ' lobes -> reading order ' + (rtl ? 'RTL' : 'LTR'));
  return out;
};

BF.prepFit = function (B, T, field, cfg) {
  var ss = cfg.ssRule && T.ssEm > 0, sidePx = ss ? T.ssEm * T.fontPx : 0, vertPx = ss ? cfg.ssVert * sidePx : 0;
  var f = B.wm.f, pts = BF.inkPoints(T.ink.alpha, T.ink.w, T.ink.h, f, ss ? 420 : 260, T.cx - T.ink.ox, T.cy - T.ink.oy, sidePx, vertPx);
  if (!pts) return null;
  var soft = (cfg.useSoft === false ? 0 : (B.soft || 0)), padMinA = (cfg.padMinEm || 0.08) * T.fontPx / f;
  var fitter = BF.makeFitter(field, pts, (ss ? cfg.ssTouchEm : cfg.padEm) * T.fontPx / f, cfg.padPx / f - soft, padMinA);
  var J = { ss: ss, B: B, T: T, field: field, fitter: fitter, sFit: fitter.maxScale(3.0), pts: pts };
  // too big for a comfortable fit?  Then shrink only as much as a tight fit needs (like a typesetter would)
  if (cfg.fill * J.sFit < 1 && cfg.padTightEm !== undefined) {
    J.tight = BF.makeFitter(field, pts, cfg.padTightEm * T.fontPx / f, cfg.padPx / f - soft, padMinA);
    J.sTight = J.tight.maxScale(1.0);
  }
  return J;
};

BF.plan = function (img, texts, cfg, log) {
  cfg = cfg || BF.CFG; var ws = {}, bubbles = [], plans = [], jobs = [];
  var sorted = texts.slice().sort(function (a, b) { return (b.target ? 1 : 0) - (a.target ? 1 : 0) || a.order - b.order; });
  sorted.forEach(function (T) {
    for (var i = 0; i < bubbles.length; i++) if (BF.inside(bubbles[i], T.cx, T.cy) && !BF.lobeIsOpen(bubbles[i], BF.lobeAt(bubbles[i], T.cx, T.cy))) { bubbles[i].members.push(T); return; }
    if (!T.target) return;
    var B = BF.detect(img, T, cfg, ws, log);
    if (B) { B.imgW = img.w; B.imgH = img.h; B.members.push(T); bubbles.push(B); }
  });
  bubbles.forEach(function (B) {
    BF.assign(B, log).forEach(function (pr) {
